<Window x:Class="PdfTranslator.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings" Icon="/Assets/PdfTranslator.ico" Width="740" SizeToContent="Height" MaxHeight="900" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Window.Resources>
        <Style TargetType="TextBlock"><Setter Property="VerticalAlignment" Value="Center" /><Setter Property="Margin" Value="0,4" /></Style>
        <Style TargetType="TextBox"><Setter Property="Margin" Value="0,4" /><Setter Property="Padding" Value="3" /></Style>
        <Style TargetType="PasswordBox"><Setter Property="Margin" Value="0,4" /><Setter Property="Padding" Value="3" /></Style>
        <Style TargetType="Button"><Setter Property="Margin" Value="8,3,0,3" /><Setter Property="Padding" Value="8,2" /></Style>
        <Style TargetType="ComboBox"><Setter Property="Margin" Value="0,4" /></Style>
        <!-- Section: a title, one line on what it is for, then its fields. -->
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" /><Setter Property="FontWeight" Value="SemiBold" /><Setter Property="Margin" Value="0,0,0,1" />
        </Style>
        <Style x:Key="SectionNote" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#666" /><Setter Property="TextWrapping" Value="Wrap" /><Setter Property="Margin" Value="0,0,0,6" />
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#777" /><Setter Property="FontSize" Value="11" /><Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>
        <Style x:Key="Section" TargetType="Border">
            <Setter Property="BorderBrush" Value="#DDD" /><Setter Property="BorderThickness" Value="0,1,0,0" />
            <Setter Property="Padding" Value="0,10,0,6" /><Setter Property="Margin" Value="0,4,0,0" />
        </Style>
        <!-- Editable model list: the box holds the model name, the list shows what each one is. -->
        <Style x:Key="ModelBox" TargetType="ComboBox">
            <Setter Property="Margin" Value="0,4" />
            <Setter Property="IsEditable" Value="True" />
            <Setter Property="TextSearch.TextPath" Value="Id" />
            <Setter Property="ItemTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Label}" MinWidth="220" Margin="0" />
                            <TextBlock Text="{Binding Id}" Foreground="#888" Margin="10,0,0,0" />
                        </StackPanel>
                    </DataTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <DockPanel Margin="14">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Save" IsDefault="True" Click="Save_Click" Width="90" Margin="0,0,6,0" />
            <Button Content="Cancel" IsCancel="True" Width="90" />
        </StackPanel>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Style="{StaticResource SectionNote}"
                           Text="Keys are stored encrypted for your Windows account (DPAPI) in %APPDATA%\PdfTranslator\settings.json. The buttons on the right open the page where each key is created." />

                <!-- ============================== Claude Code ============================== -->
                <Border Style="{StaticResource Section}">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="170" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.ColumnSpan="3" Style="{StaticResource SectionTitle}" Text="Claude — with your Claude Code sign-in" />
                        <TextBlock Grid.Row="1" Grid.ColumnSpan="3" Style="{StaticResource SectionNote}"
                                   Text="For the service “Claude (Claude Code sign-in, no API key)”. Runs the Claude Code program signed in with your Claude account; use counts against your Claude plan. Separate from the Anthropic API key below." />

                        <TextBlock Grid.Row="2" Text="Claude Code program" />
                        <TextBox Grid.Row="2" Grid.Column="1" x:Name="ClaudeCodePath" ToolTip="Found automatically; enter a path only to use a different claude.exe" />
                        <Button Grid.Row="2" Grid.Column="2" Content="Download…" Tag="https://claude.com/claude-code" Click="Link_Click" />
                        <TextBlock Grid.Row="3" Grid.Column="1" x:Name="ClaudeCodeFound" Style="{StaticResource Hint}" />

                        <TextBlock Grid.Row="4" Text="Model" />
                        <ComboBox Grid.Row="4" Grid.Column="1" x:Name="ClaudeCodeModel" Style="{StaticResource ModelBox}"
                                  ToolTip="Empty = Claude Code's default. A family name follows the latest model of that family; a full model ID can also be typed." />
                        <TextBlock Grid.Row="5" Grid.Column="1" x:Name="ClaudeCodeModelHint" Style="{StaticResource Hint}" />

                        <TextBlock Grid.Row="6" Text="Sign-in token (optional)" />
                        <PasswordBox Grid.Row="6" Grid.Column="1" x:Name="ClaudeCodeToken"
                                     ToolTip="Only needed if Claude Code has no saved /login. “Get token…” runs claude setup-token in a terminal; paste what it prints here." />
                        <Button Grid.Row="6" Grid.Column="2" x:Name="GetTokenButton" Content="Get token…" Click="GetToken_Click"
                                ToolTip="Opens a terminal running: claude setup-token" />
                    </Grid>
                </Border>

                <!-- ============================== Anthropic API ============================== -->
                <Border Style="{StaticResource Section}">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="170" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.ColumnSpan="3" Style="{StaticResource SectionTitle}" Text="Claude — with an Anthropic API key" />
                        <TextBlock Grid.Row="1" Grid.ColumnSpan="3" Style="{StaticResource SectionNote}"
                                   Text="For the service “Claude (Anthropic API key)”. Billed per use to your Anthropic Console account. Not needed for the Claude Code sign-in above." />

                        <TextBlock Grid.Row="2" Text="API key" />
                        <PasswordBox Grid.Row="2" Grid.Column="1" x:Name="AnthropicKey" LostFocus="AnthropicKey_LostFocus"
                                     ToolTip="Leave empty to use the ANTHROPIC_API_KEY environment variable" />
                        <Button Grid.Row="2" Grid.Column="2" Content="Get key…" Tag="https://console.anthropic.com/settings/keys" Click="Link_Click" />

                        <TextBlock Grid.Row="3" Text="Model" />
                        <ComboBox Grid.Row="3" Grid.Column="1" x:Name="AnthropicModel" Style="{StaticResource ModelBox}"
                                  ToolTip="The models your API key can use, listed by Anthropic" />
                        <TextBlock Grid.Row="4" Grid.Column="1" x:Name="AnthropicModelHint" Style="{StaticResource Hint}" />
                    </Grid>
                </Border>

                <!-- ============================== Other services ============================== -->
                <Border Style="{StaticResource Section}">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="170" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.ColumnSpan="3" Style="{StaticResource SectionTitle}" Text="Other translation services" />
                        <TextBlock Grid.Row="1" Grid.ColumnSpan="3" Style="{StaticResource SectionNote}"
                                   Text="Only the service chosen in the main window is used. MyMemory and Google (free) need no key." />

                        <TextBlock Grid.Row="2" Text="DeepL API key" />
                        <PasswordBox Grid.Row="2" Grid.Column="1" x:Name="DeepLKey" />
                        <Button Grid.Row="2" Grid.Column="2" Content="Get key…" Tag="https://www.deepl.com/pro-api" Click="Link_Click" />

                        <TextBlock Grid.Row="3" Text="Google Cloud API key" />
                        <PasswordBox Grid.Row="3" Grid.Column="1" x:Name="GoogleKey" />
                        <Button Grid.Row="3" Grid.Column="2" Content="Get key…" Tag="https://console.cloud.google.com/apis/library/translate.googleapis.com" Click="Link_Click" />

                        <TextBlock Grid.Row="4" Text="Azure Translator key" />
                        <PasswordBox Grid.Row="4" Grid.Column="1" x:Name="AzureKey" />
                        <Button Grid.Row="4" Grid.Column="2" Content="Get key…" Tag="https://portal.azure.com/#create/Microsoft.CognitiveServicesTextTranslation" Click="Link_Click" />
                        <TextBlock Grid.Row="5" Text="Azure region" />
                        <TextBox Grid.Row="5" Grid.Column="1" x:Name="AzureRegion" ToolTip="e.g. westeurope; leave empty for a global resource" />

                        <TextBlock Grid.Row="6" Text="LibreTranslate server" />
                        <TextBox Grid.Row="6" Grid.Column="1" x:Name="LibreUrl" ToolTip="For “LibreTranslate (server)”: a hosted or self-hosted server. The offline one is set up below." />
                        <Button Grid.Row="6" Grid.Column="2" Content="Open site…" Click="LibreSite_Click" ToolTip="Opens the server URL" />
                        <TextBlock Grid.Row="7" Text="LibreTranslate key" />
                        <PasswordBox Grid.Row="7" Grid.Column="1" x:Name="LibreKey" />
                        <Button Grid.Row="7" Grid.Column="2" Content="Get key…" Tag="https://portal.libretranslate.com" Click="Link_Click" />

                        <TextBlock Grid.Row="8" Text="MyMemory e-mail (optional)" />
                        <TextBox Grid.Row="8" Grid.Column="1" x:Name="MyMemoryEmail" ToolTip="Raises MyMemory's free daily quota" />
                        <Button Grid.Row="8" Grid.Column="2" Content="Limits…" Tag="https://mymemory.translated.net/doc/usagelimits.php" Click="Link_Click" />
                    </Grid>
                </Border>

                <!-- ============================== Offline AI ============================== -->
                <Border Style="{StaticResource Section}">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="170" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.ColumnSpan="3" Style="{StaticResource SectionTitle}" Text="Offline AI — a language model on this PC (Ollama)" />
                        <TextBlock Grid.Row="1" Grid.ColumnSpan="3" Style="{StaticResource SectionNote}"
                                   Text="For the service “Offline AI (Ollama, on this PC)”. Free and private; follows the meaning far better than LibreTranslate, but takes minutes per page on a laptop. Larger models translate better and run slower." />

                        <TextBlock Grid.Row="2" Text="Ollama" />
                        <TextBlock Grid.Row="2" Grid.Column="1" x:Name="OllamaStatus" TextWrapping="Wrap" Foreground="#555" />

                        <!-- Which downloaded model translates. -->
                        <TextBlock Grid.Row="3" Text="Use model" />
                        <ComboBox Grid.Row="3" Grid.Column="1" x:Name="OllamaModel" Style="{StaticResource ModelBox}" IsEditable="False"
                                  SelectedValuePath="Id" DropDownOpened="OllamaModel_DropDownOpened"
                                  ToolTip="The models already downloaded to this PC" />
                        <TextBlock Grid.Row="4" Grid.Column="1" x:Name="OllamaModelHint" Style="{StaticResource Hint}" />

                        <!-- Getting another one. -->
                        <TextBlock Grid.Row="5" Text="Download a model" />
                        <TextBox Grid.Row="5" Grid.Column="1" x:Name="OllamaDownloadName"
                                 ToolTip="A model name as ollama.com/library shows it: family:size, e.g. qwen3:8b" />
                        <StackPanel Grid.Row="5" Grid.Column="2" Orientation="Horizontal">
                            <Button x:Name="OllamaInstallButton" Content="Download" Click="OllamaInstall_Click"
                                    ToolTip="Downloads this model (and installs Ollama first if needed), in a progress window" />
                            <Button Content="Browse…" Tag="https://ollama.com/library" Click="Link_Click" ToolTip="Browse models at ollama.com/library" />
                        </StackPanel>
                        <TextBlock Grid.Row="6" Grid.Column="1" x:Name="OllamaDownloadHint" Style="{StaticResource Hint}" />
                    </Grid>
                </Border>

                <!-- ============================== This PC ============================== -->
                <Border Style="{StaticResource Section}">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="170" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.ColumnSpan="3" Style="{StaticResource SectionTitle}" Text="On this PC" />

                        <TextBlock Grid.Row="1" Text="Offline translation" />
                        <TextBlock Grid.Row="1" Grid.Column="1" x:Name="OfflineStatus" TextWrapping="Wrap" Foreground="#555"
                                   ToolTip="LibreTranslate running on this PC: free, private, no internet needed after installing" />
                        <StackPanel Grid.Row="1" Grid.Column="2" Orientation="Horizontal">
                            <Button x:Name="OfflineInstallButton" Content="Install…" Click="OfflineInstall_Click"
                                    ToolTip="Downloads LibreTranslate with its own Python (about 1 GB) in a progress window" />
                            <Button Content="About…" Tag="https://github.com/LibreTranslate/LibreTranslate" Click="Link_Click" />
                        </StackPanel>

                        <TextBlock Grid.Row="2" Text="OCR languages" />
                        <TextBlock Grid.Row="2" Grid.Column="1" x:Name="OcrLanguages" TextWrapping="Wrap" Foreground="#555" />
                        <Button Grid.Row="2" Grid.Column="2" Content="Add language…" Tag="ms-settings:regionlanguage" Click="Link_Click"
                                ToolTip="Windows Settings › Language &amp; region: add a language, then its Optical character recognition feature" />
                        <TextBlock Grid.Row="3" Grid.Column="1" Style="{StaticResource Hint}"
                                   Text="Optional: Chinese and Japanese are read by the built-in PaddleOCR engine either way." />

                        <TextBlock Grid.Row="4" Text="MCP server for Claude" />
                        <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal" Margin="0,4">
                            <CheckBox x:Name="McpEnabled" Content="Enabled on localhost, port" VerticalAlignment="Center"
                                      ToolTip="Lets Claude Code or Claude Desktop read and edit the open PDF" />
                            <TextBox x:Name="McpPort" Width="60" Margin="6,0,0,0" />
                        </StackPanel>
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
