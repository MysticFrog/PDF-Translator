<Window x:Class="PdfTranslator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PDF Translator" Icon="/Assets/PdfTranslator.ico" Width="1400" Height="900" MinWidth="900" MinHeight="500"
        AllowDrop="True" Drop="Window_Drop" PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <Style TargetType="ToggleButton">
            <Setter Property="Padding" Value="8,2" />
            <Setter Property="Margin" Value="2,0" />
            <Setter Property="MinWidth" Value="26" />
        </Style>
        <Style x:Key="EditButton" TargetType="Button">
            <Setter Property="Padding" Value="8,2" />
            <Setter Property="Margin" Value="2,0" />
        </Style>
    </Window.Resources>
    <DockPanel>
        <!-- Toolbar -->
        <Border DockPanel.Dock="Top" Background="#F3F3F3" BorderBrush="#DDD" BorderThickness="0,0,0,1" Padding="6">
            <WrapPanel>
                <Button Content="Open PDF…" Click="Open_Click" FontWeight="SemiBold" />
                <TextBlock Text="From" Style="{StaticResource Caption}" />
                <ComboBox x:Name="SourceBox" Width="190" />
                <TextBlock Text="To" Style="{StaticResource Caption}" />
                <ComboBox x:Name="TargetBox" Width="190" />
                <TextBlock Text="Service" Style="{StaticResource Caption}" />
                <ComboBox x:Name="ProviderBox" Width="270" SelectionChanged="ProviderBox_SelectionChanged" />
                <TextBlock Text="OCR" Style="{StaticResource Caption}" />
                <ComboBox x:Name="OcrBox" Width="210" />
                <Button Content="Settings…" Click="Settings_Click" Margin="8,0,2,0" />
                <Separator Margin="6,0" />
                <Button x:Name="TranslatePageButton" Content="Translate page" Click="TranslatePage_Click" IsEnabled="False" />
                <Button x:Name="TranslateAllButton" Content="Translate all" Click="TranslateAll_Click" IsEnabled="False" FontWeight="SemiBold" />
                <Button x:Name="CancelButton" Content="Cancel" Click="Cancel_Click" IsEnabled="False" />
                <Button x:Name="SaveButton" Content="Save translated PDF…" Click="Save_Click" IsEnabled="False" />
            </WrapPanel>
        </Border>

        <!-- Status bar -->
        <Border DockPanel.Dock="Bottom" Background="#F3F3F3" BorderBrush="#DDD" BorderThickness="0,1,0,0" Padding="6,3">
            <DockPanel LastChildFill="True">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <Button Content="◀" Click="Prev_Click" Padding="8,0" />
                    <TextBlock Text="Page" Style="{StaticResource Caption}" Margin="4,0" />
                    <TextBox x:Name="PageBox" Width="40" VerticalContentAlignment="Center" KeyDown="PageBox_KeyDown" />
                    <TextBlock x:Name="PageCountText" Text="/ 0" Style="{StaticResource Caption}" Margin="4,0" />
                    <Button Content="▶" Click="Next_Click" Padding="8,0" />
                    <TextBlock Text="Zoom" Style="{StaticResource Caption}" Margin="16,0,4,0" />
                    <Slider x:Name="ZoomSlider" ToolTip="Ctrl + mouse wheel over a page also zooms" Width="140" Minimum="0.25" Maximum="5" Value="1" VerticalAlignment="Center"
                            ValueChanged="ZoomSlider_ValueChanged" />
                    <TextBlock x:Name="ZoomText" Text="100%" Style="{StaticResource Caption}" Width="44" />
                    <Button Content="Fit width" Click="FitWidth_Click" Padding="6,0" />
                    <CheckBox x:Name="SyncScrollBox" Content="Sync scroll" IsChecked="True" VerticalAlignment="Center" Margin="12,0,4,0" />
                    <CheckBox x:Name="OutlinesBox" Content="Show blocks" IsChecked="True" VerticalAlignment="Center" Margin="8,0"
                              Click="OutlinesBox_Click" />
                </StackPanel>
                <ProgressBar x:Name="Progress" DockPanel.Dock="Right" Width="160" Height="14" Margin="8,0,0,0" />
                <TextBlock x:Name="McpText" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="8,0" Foreground="#555"
                           Cursor="Hand" MouseLeftButtonUp="McpText_Click" ToolTip="Click to copy the MCP endpoint and the Claude Code command" />
                <TextBlock x:Name="StatusText" VerticalAlignment="Center" Margin="12,0" TextTrimming="CharacterEllipsis"
                           Text="Open a PDF to begin (or drop one onto the window)." />
            </DockPanel>
        </Border>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="5" />
                <RowDefinition Height="230" MinHeight="60" />
            </Grid.RowDefinitions>

            <!-- Side-by-side preview -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="5" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <DockPanel Grid.Column="0">
                    <TextBlock DockPanel.Dock="Top" Text="Original — click a block to select it; Shift+drag to add a block the detector missed" FontWeight="SemiBold" Padding="8,4" Background="#E8E8E8" />
                    <ScrollViewer x:Name="LeftScroll" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                                  Background="#8A8A8A" ScrollChanged="LeftScroll_ScrollChanged" PreviewMouseWheel="Preview_MouseWheel">
                        <Grid x:Name="LeftHost" Margin="16" HorizontalAlignment="Center" VerticalAlignment="Top">
                            <Grid.LayoutTransform>
                                <ScaleTransform x:Name="LeftScale" />
                            </Grid.LayoutTransform>
                            <Image x:Name="LeftImage" Stretch="None" SnapsToDevicePixels="True" />
                            <Canvas x:Name="LeftOverlay" Background="Transparent" ClipToBounds="True"
                                    MouseLeftButtonDown="LeftOverlay_MouseLeftButtonDown" MouseMove="LeftOverlay_MouseMove"
                                    MouseLeftButtonUp="LeftOverlay_MouseLeftButtonUp" MouseRightButtonUp="Overlay_MouseRightButtonUp" />
                        </Grid>
                    </ScrollViewer>
                </DockPanel>

                <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Background="#CCC" />

                <DockPanel Grid.Column="2">
                    <TextBlock x:Name="RightHeader" DockPanel.Dock="Top" Text="Translated" FontWeight="SemiBold" Padding="8,4" Background="#E8E8E8" />
                    <ScrollViewer x:Name="RightScroll" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                                  Background="#8A8A8A" ScrollChanged="RightScroll_ScrollChanged" PreviewMouseWheel="Preview_MouseWheel">
                        <Grid>
                            <Grid x:Name="RightHost" Margin="16" HorizontalAlignment="Center" VerticalAlignment="Top">
                                <Grid.LayoutTransform>
                                    <ScaleTransform x:Name="RightScale" />
                                </Grid.LayoutTransform>
                                <Image x:Name="RightImage" Stretch="None" SnapsToDevicePixels="True" />
                                <Canvas x:Name="RightOverlay" Background="Transparent" ClipToBounds="True" Focusable="True"
                                        MouseLeftButtonDown="RightOverlay_MouseLeftButtonDown"
                                        MouseMove="RightOverlay_MouseMove"
                                        MouseLeftButtonUp="RightOverlay_MouseLeftButtonUp"
                                        MouseRightButtonUp="Overlay_MouseRightButtonUp" />
                            </Grid>
                            <TextBlock x:Name="RightPlaceholder" Text="Not translated yet" Foreground="White" FontSize="18"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" />
                        </Grid>
                    </ScrollViewer>
                </DockPanel>
            </Grid>

            <GridSplitter Grid.Row="1" HorizontalAlignment="Stretch" Background="#CCC" />

            <!-- Block editor -->
            <DockPanel Grid.Row="2">
                <Border DockPanel.Dock="Top" Background="#E8E8E8" Padding="4,3">
                    <DockPanel>
                        <TextBlock x:Name="BlocksHeader" Text="Text blocks" FontWeight="SemiBold" VerticalAlignment="Center" Margin="4,0,10,0" DockPanel.Dock="Left" />
                        <WrapPanel x:Name="EditBar" IsEnabled="False">
                            <ToggleButton x:Name="BoldButton" Content="B" FontWeight="Bold" Click="Bold_Click" ToolTip="Bold (Ctrl+B)" />
                            <ToggleButton x:Name="ItalicButton" Content="I" FontStyle="Italic" Click="Italic_Click" ToolTip="Italic (Ctrl+I)" />
                            <TextBlock Text="Size" Style="{StaticResource Caption}" Margin="6,0,2,0" />
                            <TextBox x:Name="SizeBox" Width="42" VerticalContentAlignment="Center" KeyDown="SizeBox_KeyDown"
                                     ToolTip="Font size in points; Enter to apply" />
                            <Button Content="−" Style="{StaticResource EditButton}" Click="SizeDown_Click" ToolTip="Smaller (Ctrl+-)" />
                            <Button Content="+" Style="{StaticResource EditButton}" Click="SizeUp_Click" ToolTip="Larger (Ctrl++)" />
                            <Button Content="Auto" Style="{StaticResource EditButton}" Click="SizeAuto_Click" ToolTip="Fit size automatically" />
                            <ComboBox x:Name="AlignBox" Width="80" SelectionChanged="AlignBox_SelectionChanged" Margin="6,0" />
                            <Button Content="Edit text" Style="{StaticResource EditButton}" Click="EditText_Click" ToolTip="Edit translation in place (F2 / double-click)" />
                            <Button Content="Merge" Style="{StaticResource EditButton}" Click="Merge_Click" ToolTip="Merge selected blocks into one (Ctrl+M)" />
                            <Button Content="Split lines" Style="{StaticResource EditButton}" Click="Split_Click" ToolTip="Split block into one block per source line" />
                            <ToggleButton x:Name="KeepButton" Content="Keep original" Click="Keep_Click" ToolTip="Leave the original text (Del toggles)" />
                            <Button Content="Reset layout" Style="{StaticResource EditButton}" Click="ResetLayout_Click" ToolTip="Back to automatic position and size" />
                            <Button Content="Delete block" Style="{StaticResource EditButton}" Click="DeleteBlock_Click" ToolTip="Remove the block (the original stays visible)" />
                            <Button Content="Re-translate" Style="{StaticResource EditButton}" Click="Retranslate_Click" />
                        </WrapPanel>
                    </DockPanel>
                </Border>
                <Border DockPanel.Dock="Top" Background="#F7F7F7" Padding="6,2">
                    <DockPanel>
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                            <ToggleButton x:Name="ImageModeButton" Content="🖼 Images &amp; stamps" Click="ImageMode_Click"
                                          ToolTip="Select images, stamps, watermarks and annotations instead of text, to delete them" />
                            <Button x:Name="DeleteImageButton" Content="Delete image" Style="{StaticResource EditButton}" Click="DeleteImage_Click" IsEnabled="False"
                                    ToolTip="Remove the selected images from the output PDF (Del)" />
                            <Button x:Name="DeleteImageAllButton" Content="…on all pages" Style="{StaticResource EditButton}" Click="DeleteImageAll_Click" IsEnabled="False"
                                    ToolTip="Also delete images with the same size and position on every page (repeated stamps, logos)" />
                            <Button x:Name="RestoreImageButton" Content="Restore" Style="{StaticResource EditButton}" Click="RestoreImage_Click" IsEnabled="False" />
                            <Separator Margin="6,0" />
                            <Button Content="↶ Undo" Style="{StaticResource EditButton}" Click="Undo_Click" ToolTip="Ctrl+Z" />
                            <Button Content="↷ Redo" Style="{StaticResource EditButton}" Click="Redo_Click" ToolTip="Ctrl+Y" />
                            <Button Content="Re-analyse page" Style="{StaticResource EditButton}" Click="Reanalyze_Click"
                                    ToolTip="Discard edits on this page and detect blocks again" />
                        </StackPanel>
                        <TextBlock Foreground="#666" VerticalAlignment="Center" FontSize="11" TextTrimming="CharacterEllipsis"
                                   Text="Translated page: drag a block to move it, drag its corner to resize, double-click to edit. Ctrl+click adds to the selection; arrows nudge (Shift = 10pt)." />
                    </DockPanel>
                </Border>
                <DataGrid x:Name="BlocksGrid" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                          HeadersVisibility="Column" GridLinesVisibility="Horizontal" SelectionMode="Extended"
                          SelectionChanged="BlocksGrid_SelectionChanged" CellEditEnding="BlocksGrid_CellEditEnding"
                          BeginningEdit="BlocksGrid_BeginningEdit">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="#" Binding="{Binding Id, Mode=OneWay}" Width="34" IsReadOnly="True" />
                        <DataGridTextColumn Header="Source" Binding="{Binding OriginLabel, Mode=OneWay}" Width="90" IsReadOnly="True" />
                        <DataGridTextColumn Header="Style" Binding="{Binding StyleLabel, Mode=OneWay}" Width="58" IsReadOnly="True" />
                        <DataGridTextColumn Header="Original text" Binding="{Binding Source, Mode=OneWay}" Width="*" IsReadOnly="True">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap" /></Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Translation (editable)" Binding="{Binding Translated, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Width="*">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap" /></Style>
                            </DataGridTextColumn.ElementStyle>
                            <DataGridTextColumn.EditingElementStyle>
                                <Style TargetType="TextBox">
                                    <Setter Property="TextWrapping" Value="Wrap" />
                                    <Setter Property="AcceptsReturn" Value="True" />
                                </Style>
                            </DataGridTextColumn.EditingElementStyle>
                        </DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Grid>
    </DockPanel>
</Window>
