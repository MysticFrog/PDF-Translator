<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>PdfTranslator</RootNamespace>
    <AssemblyName>PdfTranslator</AssemblyName>
    <Version>1.2.0</Version>
    <ApplicationIcon>Assets\PdfTranslator.ico</ApplicationIcon>
    <Company>Andrew Jones</Company>
    <Copyright>Copyright © 2026 Andrew Jones</Copyright>
    <Product>PDF Translator</Product>
    <!-- dist\ holds the published app and installer; tools\ the installer project. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);dist\**;tools\**</DefaultItemExcludes>
  </PropertyGroup>

  <!--
    "Dist" is Release for the self-contained publish (build.ps1 -Installer). It has its own bin\obj
    folders: sharing them with the framework-dependent Release build left a self-contained launcher
    in bin\Release that then failed with "You must install .NET".
  -->
  <PropertyGroup Condition=" '$(Configuration)' == 'Dist' ">
    <Optimize>true</Optimize>
    <DebugType>none</DebugType>
    <SelfContained>true</SelfContained>
  </PropertyGroup>

  <!--
    "Slim" is Release for the small installer: framework-dependent, so .NET is not inside it. The installer
    puts the runtime either machine-wide or, without administrator rights, in a "dotnet" folder beside the
    program; the launcher looks there first, then in the usual machine-wide places.
  -->
  <PropertyGroup Condition=" '$(Configuration)' == 'Slim' ">
    <Optimize>true</Optimize>
    <DebugType>none</DebugType>
    <SelfContained>false</SelfContained>
    <AppHostRelativeDotNet>dotnet</AppHostRelativeDotNet>
    <AppHostDotNetSearch>AppRelative;Global</AppHostDotNetSearch>
  </PropertyGroup>

  <ItemGroup>
    <!-- The installer is its own project (tools\Setup); keep its sources out of the application. -->
    <Compile Remove="tools\**" />
    <None Remove="tools\**" />
    <Page Remove="tools\**" />
    <Resource Include="Assets\PdfTranslator.ico" />
    <!-- Licences of the bundled components (generated by tools\Notices.ps1; shown from About). -->
    <None Include="THIRD-PARTY-NOTICES.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- ONNX Runtime's package also drops its import libraries (*.lib); they are for linking, not running. -->
  <Target Name="DropImportLibsFromBuild" AfterTargets="Build">
    <ItemGroup><_ImportLibs Include="$(OutDir)*.lib" /></ItemGroup>
    <Delete Files="@(_ImportLibs)" />
  </Target>
  <Target Name="DropImportLibsFromPublish" AfterTargets="Publish">
    <ItemGroup><_PublishedLibs Include="$(PublishDir)*.lib" /></ItemGroup>
    <Delete Files="@(_PublishedLibs)" />
  </Target>

  <ItemGroup>
    <Using Include="System.IO" />
    <Using Include="System.Net.Http" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="PdfPig" Version="0.1.16" />
    <PackageReference Include="PDFsharp" Version="6.1.1" />
    <PackageReference Include="PDFtoImage" Version="4.1.1" />
    <PackageReference Include="Tesseract" Version="5.2.0" />
    <PackageReference Include="RapidOcrNet" Version="4.2.0" />
    <PackageReference Include="Anthropic" Version="13.3.0" />
  </ItemGroup>

  <!-- version.commits+hash[.dirty] on every build -->
  <Import Project="GitVersion.targets" />

</Project>
